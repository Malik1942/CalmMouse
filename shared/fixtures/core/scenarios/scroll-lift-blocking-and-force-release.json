    {"op": "scroll", "t": 5.1, "phase": "began", "deltaY": 3},
    {"op": "scroll", "t": 5.2, "phase": "changed", "deltaY": 3},
    {"op": "scroll", "t": 5.3, "phase": "changed", "deltaY": 3},
    {"op": "scroll", "t": 5.31, "phase": "ended"},
