    {"op": "liftBlockingImmediately"},
    {"op": "scroll", "t": 0.03, "phase": "changed", "deltaY": 3},
    {"op": "scroll", "t": 0.04, "phase": "ended"},
    {"op": "scroll", "t": 0.05, "momentum": "began", "deltaY": 20},
