    {"op": "magicMouseButton", "button": 0, "isDown": true, "t": 8.0},
    {"op": "scroll", "t": 8.01, "phase": "mayBegin"},
    {"op": "liftBlockingImmediately"},
    {"op": "scroll", "t": 8.02, "phase": "began", "deltaY": 3},
    {"op": "scroll", "t": 8.03, "phase": "changed", "deltaY": 3},
    {"op": "scroll", "t": 8.04, "phase": "ended"}
