"Scrolling speed" = "捲動速度";
"Slow" = "慢";
"Fast" = "快";
"Welcome Tour" = "歡迎導覽";
"Accessibility" = "輔助使用";
"Automatic" = "自動";
"Check Now" = "立即檢查";
"Version %@" = "版本 %@";
"Show" = "顯示";
"Reverse direction" = "反轉方向";
"Don't scroll while pressed" = "按下時不捲動";
"Save as Preset" = "儲存為預置";
"Add an App" = "加入 App";
