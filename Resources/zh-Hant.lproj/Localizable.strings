/* CalmMouse — 繁體中文.
   Terminology follows macOS zh-Hant conventions: 點按 (click), 輕點 (tap), 連按 (double-click),
   拖移 (drag), 捲動 (scroll), 滑鼠 (mouse), 輔助使用 (Accessibility), 觸控式軌跡板 (trackpad). */

/* Menu bar */
"Grant Accessibility permission…" = "授予輔助使用權限…";
"CalmMouse enabled" = "啟用 CalmMouse";
"Don't scroll while clicking" = "點按時不捲動";
"Keep gliding after a swipe" = "輕掃後繼續滑動";
"Scroll in straight lines" = "沿直線捲動";
"Tap to click" = "輕點來點按";
"Ignore scrolling in this app" = "在目前 App 中忽略捲動";
"Ignore scrolling in %@" = "在「%@」中忽略捲動";
"Settings…" = "設定…";
"Quit CalmMouse" = "結束 CalmMouse";
"CalmMouse needs Accessibility permission" = "CalmMouse 需要輔助使用權限";
"CalmMouse is paused" = "CalmMouse 已暫停";
"CalmMouse couldn't start its event tap" = "CalmMouse 無法啟動事件監聽";
"CalmMouse — active · Magic Mouse battery low" = "CalmMouse — 運作中 · 巧控滑鼠電量不足";
"CalmMouse — active" = "CalmMouse — 運作中";
"⚠︎ Event tap failed to start" = "⚠︎ 事件監聽啟動失敗";
"Update available — CalmMouse %@…" = "有可用更新 — CalmMouse %@…";

/* Settings window + tabs */
"General" = "一般";
"Presets" = "預置";
"Apps" = "App";
"Shortcuts" = "快速鍵";

/* General tab */
"Enable CalmMouse" = "啟用 CalmMouse";
"Launch at login" = "登入時啟動";
"Open Settings…" = "打開設定…";
"Toggle already ON in System Settings but still not working? The stored grant is stale (usually after a rebuild). Reset it and grant again." = "系統設定裡的開關已打開卻仍沒有作用？表示儲存的授權已失效（通常發生在重新建置之後）。重置後重新授權即可。";
"Reset grant…" = "重置授權…";
"Couldn't change the login item" = "無法更改登入項目";
"Launch at login only works when CalmMouse runs from an app bundle (e.g. /Applications)." = "只有當 CalmMouse 從 App 套件（如 /Applications）執行時，「登入時啟動」才可用。";

/* Updates */
"You're up to date." = "已是最新版本。";
"CalmMouse %@ is available." = "CalmMouse %@ 已推出。";
"Update Now" = "立即更新";
"Full release notes ›" = "完整更新說明 ›";
"Downloading…" = "正在下載…";
"Installing — CalmMouse will relaunch itself in a moment." = "正在安裝——CalmMouse 稍後會自動重新啟動。";
"Download from the website instead ›" = "改從網站下載 ›";
"Couldn't read the releases feed." = "無法讀取發佈來源。";
"This release has no download attached — grab it from the website." = "此版本沒有附帶下載檔案——請從網站取得。";
"Download failed." = "下載失敗。";
"The downloaded archive didn't contain CalmMouse.app." = "下載的壓縮檔中沒有 CalmMouse.app。";
"The downloaded app isn't CalmMouse." = "下載的 App 不是 CalmMouse。";
"Couldn't replace %@ — download the update from the website instead. (%@)" = "無法替換 %@——請改從網站下載更新。（%@）";
"%@ failed: %@" = "%@ 執行失敗：%@";

/* Presets tab */
"Preset name" = "預置名稱";
"Use" = "使用";
"Delete this preset" = "刪除此預置";

/* Built-in presets (defined in CalmMouseCore, translated at display time) */
"Just fix clicking" = "只修好點按";
"Pages hold still while you click.\nNothing else changes." = "點按時頁面保持不動。\n其他一切不變。";
"Extra steady" = "格外穩定";
"Ignores nudges and diagonal drift.\nThe page stops when your finger does." = "忽略輕微觸碰和斜向偏移。\n手指一停頁面就停。";
"Trackpad feel" = "軌跡板手感";
"Tap to click and right-click.\nDouble Tap Drag to move things." = "輕點來點按和右鍵點按。\n輕點兩下拖移來移動物件。";

/* Scrolling tab */
"The page stays put while you click." = "點按時頁面保持不動。";
"Hold still after you let go" = "放開後稍作停頓";
"A short pause after you let go,\nso a lifting finger can't scroll." = "放開後稍作停頓，\n抬起手指時不會帶動頁面。";
"Off" = "關";
"Ignore small finger nudges" = "忽略手指的輕微觸碰";
"Scrolling waits for this much travel.\nA resting finger can't move the page." = "滑動超過這段距離才開始捲動。\n搭著的手指不會帶動頁面。";
"A swipe that drifts stays straight." = "輕掃略有偏斜也能走直線。";
"Lock direction after sliding" = "滑動多遠後鎖定方向";
"How far a swipe goes before it locks." = "滑動多遠後鎖定方向。";
"On: the page glides after a swipe.\nOff: it stops when your finger does." = "開：輕掃後頁面繼續滑動。\n關：手指一停頁面就停。";
"Ignore sideways scrolling" = "忽略橫向捲動";
"Sideways swipes do nothing." = "橫向輕掃不起作用。";

/* Clicking tab */
"A light tap clicks.\nPressing the mouse still works." = "輕輕一點即點按。\n按下滑鼠依然有效。";
"Firm: only quick, deliberate taps.\nLight: gentler, slower taps too." = "重：只有快速、刻意的輕點。\n輕：輕柔、較慢的輕點也算。";
"Firm" = "重";
"Light" = "輕";
"Tap to right-click" = "輕點來右鍵點按";
"Tap twice quickly to right-click.\nPress the mouse to double-click." = "快速輕點兩下來右鍵點按。\n連按請按下滑鼠。";
"Tap the right side to right-click.\nTaps elsewhere are normal clicks." = "輕點右側來右鍵點按。\n其他位置仍是一般點按。";
"A tap on the right side" = "輕點右側";
"A double-tap" = "連續輕點兩下";
"Front of the mouse only" = "僅滑鼠前部";
"Only taps near the front count.\nYour grip can't click by accident." = "只有靠近前端的輕點才算數。\n握持的手指不會誤觸。";
"Size of the tap area" = "輕點區域大小";
"Double Tap Drag" = "輕點兩下拖移";
"Tap twice and leave your finger down.\nMove the mouse right away to drag.\nLift your finger to drop." = "輕點兩下，第二下手指不抬起。\n馬上移動滑鼠開始拖移。\n抬起手指即放下。";
"Use the left or middle of the mouse." = "請使用滑鼠的左側或中間。";
"Two-finger drag" = "雙指拖移";
"Rest two fingers and hold a moment.\nMove the mouse to drag.\nLift your fingers to drop." = "兩指放上並停留片刻。\n移動滑鼠開始拖移。\n抬起手指即放下。";

/* Apps tab */
"Rule enabled" = "啟用規則";
"Ignore Magic Mouse scrolling" = "忽略巧控滑鼠捲動";
"Default" = "預設";
"On" = "開";

/* Shortcuts tab */
"While holding %@" = "按住 %@ 時";
"Hold a key while you scroll\nto do the action you picked." = "捲動時按住按鍵，\n可以執行你選擇的操作。";
"Scroll normally" = "正常捲動";
"Scroll sideways" = "橫向捲動";
"Scroll in reverse" = "反向捲動";
"Zoom in apps" = "在 App 中縮放";
"Zoom the whole screen" = "縮放整個螢幕";
"Do nothing" = "不執行任何動作";

/* Battery tab */
"Magic Mouse" = "巧控滑鼠";
"Low battery warning" = "電量不足警告";

/* Onboarding */
"Welcome to CalmMouse" = "歡迎使用 CalmMouse";
"Your Magic Mouse's whole top is a touch surface — and it stays live while you click, so pages jump around. CalmMouse fixes that." = "巧控滑鼠的整個頂面都是觸控表面——而且在點按時依然作用，所以頁面總是亂跳。CalmMouse 解決這個問題。";
"The page holds still while you click. That's the main fix — the next steps set it up." = "點按時頁面保持不動。這就是核心修復——接下來幾步完成設定。";
"Allow CalmMouse to see mouse events" = "允許 CalmMouse 看到滑鼠事件";
"macOS calls this Accessibility access. It's how CalmMouse can tell a click from a scroll — it never sees keystrokes and never touches the network." = "macOS 稱之為輔助使用權限。CalmMouse 靠它分辨點按和捲動——它不會看到鍵盤輸入，也從不連網。";
"Access granted — you're all set." = "已授權——一切就緒。";
"Turn on CalmMouse in System Settings → Privacy & Security → Accessibility." = "在系統設定 → 隱私權與安全性 → 輔助使用中打開 CalmMouse。";
"Open System Settings…" = "打開系統設定…";
"You can also do this later — CalmMouse waits in the menu bar and starts working within two seconds of being allowed." = "也可以稍後再做——CalmMouse 會在選單列等著，授權後兩秒內開始運作。";
"Pick a starting point" = "選擇一個起點";
"One click sets everything up. You can tweak any single setting afterwards — and save your own presets in Settings → Magic Mouse." = "一鍵完成全部設定。之後可以單獨調整任何選項——還能在設定 → 巧控滑鼠中儲存自己的預置。";
"Try it" = "試一試";
"Grab your Magic Mouse and put the cursor over any page you can scroll — this window's background works too." = "拿起巧控滑鼠，把游標放在任何可捲動的頁面上——這個視窗的背景也可以。";
"Click and hold the mouse button." = "按住滑鼠按鈕不放。";
"Slide your finger along the surface, like a scroll." = "手指沿表面滑動，就像捲動一樣。";
"The page stays put — that scroll was swallowed." = "頁面紋絲不動——那次捲動被攔下了。";
"Also try a light tap — no press needed. That's tap to click." = "再試試輕輕一點——無需按壓。這就是輕點來點按。";
"Accessibility access isn't granted yet, so nothing is blocked. Go back one step to turn it on." = "尚未授予輔助使用權限，所以什麼都不會被攔截。回到上一步打開它。";
"It works! **1** accidental scroll calmed just now." = "有效了！剛剛安撫了 **1** 次誤捲動。";
"It works! **%ld** accidental scrolls calmed just now." = "有效了！剛剛安撫了 **%ld** 次誤捲動。";
"Waiting for a click-and-slide on the Magic Mouse…" = "等待在巧控滑鼠上按住並滑動…";
"That's it" = "完成了";
"CalmMouse lives in your menu bar and keeps working in the background." = "CalmMouse 常駐選單列，在背景持續運作。";
"Look for the mouse icon in the menu bar — the everyday switches live there. Orange means it needs attention, dimmed means paused." = "在選單列找到滑鼠圖像——常用開關都在那裡。橙色表示需要處理，變暗表示已暫停。";
"In Settings, hover any option for a little animated preview of what it does." = "在設定中，將指標懸停在任一選項上，就能看到示範其效果的小動畫。";
"Changed your mind about the feel? Settings → Magic Mouse switches the whole setup in one click, or saves your own." = "想換種手感？設定 → 巧控滑鼠可以一鍵切換整套設定，也能儲存你自己的預置。";
"Back" = "返回";
"Continue" = "繼續";
"Start Using CalmMouse" = "開始使用 CalmMouse";

