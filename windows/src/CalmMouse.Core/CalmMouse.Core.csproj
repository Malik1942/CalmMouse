<Project Sdk="Microsoft.NET.Sdk">

  <!-- The core logic: a C# copy of CalmMouseCore. Plain net10.0, no Windows APIs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- The Swift tests use `@testable import`, so the C# ones see internals too. -->
  <ItemGroup>
    <InternalsVisibleTo Include="CalmMouse.Core.Tests" />
  </ItemGroup>

</Project>
