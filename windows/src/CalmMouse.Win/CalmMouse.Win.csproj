<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows app: WPF tray app, hook, Raw Input, SendInput, settings window. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 1809 and later, so CsWin32 APIs marked Windows 10+ compile. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Per-monitor DPI awareness (v2): crisp tray icon and settings window at any scaling. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The program is CalmMouse.exe; the project, namespaces and tests keep the CalmMouse.Win name. -->
    <AssemblyName>CalmMouse</AssemblyName>
    <RootNamespace>CalmMouse.Win</RootNamespace>
    <!-- The Mac app's icon (Assets/App/make-app-icon.ps1). Windows without their own icon use it too. -->
    <ApplicationIcon>Assets\App\CalmMouse.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CalmMouse.Core\CalmMouse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The integration tests drive the input thread through a few internal test hooks. -->
    <InternalsVisibleTo Include="CalmMouse.Win.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The strings: the Mac app's tables, linked in place (never copied), and the Windows-only
      tables on top of them. Localizer.cs reads them by these names.
    -->
    <EmbeddedResource Include="..\..\..\Resources\en.lproj\Localizable.strings" Link="Strings\Mac\en.lproj\Localizable.strings" LogicalName="CalmMouse.Strings.Mac.en" />
    <EmbeddedResource Include="..\..\..\Resources\zh-Hans.lproj\Localizable.strings" Link="Strings\Mac\zh-Hans.lproj\Localizable.strings" LogicalName="CalmMouse.Strings.Mac.zh-Hans" />
    <EmbeddedResource Include="..\..\..\Resources\zh-Hant.lproj\Localizable.strings" Link="Strings\Mac\zh-Hant.lproj\Localizable.strings" LogicalName="CalmMouse.Strings.Mac.zh-Hant" />
    <EmbeddedResource Include="Strings\en.lproj\Localizable.strings" LogicalName="CalmMouse.Strings.Windows.en" />
    <EmbeddedResource Include="Strings\zh-Hans.lproj\Localizable.strings" LogicalName="CalmMouse.Strings.Windows.zh-Hans" />
    <EmbeddedResource Include="Strings\zh-Hant.lproj\Localizable.strings" LogicalName="CalmMouse.Strings.Windows.zh-Hant" />
    <!-- The tray icons (Assets/Tray/make-icons.ps1 draws them). TrayIcon.cs reads them by these names. -->
    <EmbeddedResource Include="Assets\Tray\*.ico" LogicalName="CalmMouse.Tray.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The notification-area (tray) icon. -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <!-- Generates the Win32 P/Invoke declarations listed in NativeMethods.txt. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371" PrivateAssets="all" />
  </ItemGroup>

</Project>
