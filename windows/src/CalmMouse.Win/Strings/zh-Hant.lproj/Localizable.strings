/* CalmMouse for Windows：只有 Windows 版用到的文字，繁體中文（台灣用語）。
   格式和 Mac 版 Resources/zh-Hant.lproj/Localizable.strings 相同（鍵是英文原文），
   疊加在 Mac 版的表上，同一個鍵以這裡為準。用詞跟隨 Windows：滑鼠、設定、捲動。 */

/* 通知區域圖示：選單 */
"Pause CalmMouse" = "暫停 CalmMouse";
"Resume CalmMouse" = "繼續執行 CalmMouse";
"Try again" = "再試一次";

/* 通知區域圖示：出了什麼問題（提示文字和選單頂端） */
"CalmMouse stopped because of a problem. Your mouse scrolls as usual." = "CalmMouse 發生問題，已停止運作。滑鼠會照常捲動。";
"CalmMouse couldn't start. Your mouse scrolls as usual." = "CalmMouse 無法啟動。滑鼠照常捲動。";
"Something on this PC is blocking CalmMouse, so your mouse scrolls as usual for now. It will try again soon." = "這台電腦上有程式阻擋了 CalmMouse，滑鼠暫時照常捲動，稍後會自動再試一次。";

/* 設定視窗 */
"CalmMouse Settings" = "CalmMouse 設定";
"Language" = "語言";
"Same as Windows" = "與 Windows 相同";

/* 其他滑鼠軟體。%@ 是一個名稱，或像「SmoothScroll 和 AutoHotkey」這樣的清單。 */
"%@ can also change how your mouse scrolls. If scrolling feels odd, turn off one of them." = "%@ 也可能改變滑鼠的捲動方式。如果捲動感覺不太對，請關閉其中一個。";
/* 連接清單的最後兩個名稱。 */
"%@ and %@" = "%@ 和 %@";

/* 設定視窗：頁面、右側面板裡的說明（\n 在那裡換行）、裝置和應用程式規則 */
"App rules" = "應用程式規則";
"Rules follow the window under the pointer,\nthe one the wheel scrolls,\neven when another app is in front." = "規則依指標下方的視窗來判斷，\n也就是滾輪正在捲動的視窗，\n即使它不在前景。";
"Every mouse scrolls as usual\nuntil you turn this off." = "所有滑鼠照常捲動，\n直到你關掉這一項。";
"CalmMouse starts by itself\nwhen you sign in to Windows." = "登入 Windows 時\nCalmMouse 自動啟動。";
"“Same as Windows” follows\nthe Windows display language." = "「與 Windows 相同」會使用\nWindows 的顯示語言。";
"No mouse found yet." = "尚未偵測到滑鼠。";
"Touchpad" = "觸控板";
"CalmMouse leaves the touchpad alone." = "CalmMouse 不會改動觸控板。";
"Pick an app that's open now,\nor choose a program file." = "從目前開啟的應用程式中選擇一個，\n或選擇程式檔案。";
"Add an app…" = "新增應用程式…";
"No app rules yet." = "還沒有應用程式規則。";
"Turn a rule off to keep it\nwithout using it for now." = "暫時用不到的規則可以關掉，\n不必刪除。";
"Every mouse scrolls a notch at a time here.\nFor older apps that miss small steps." = "在這裡，每隻滑鼠都一格一格地捲動。\n適合無法辨識細微捲動的舊程式。";
"No smooth scrolling in this app" = "在這個應用程式中關閉平滑捲動";
"CalmMouse doesn't touch scrolling here:\nno smoothing, no reversing, nothing blocked." = "CalmMouse 不處理這裡的捲動：\n不平滑、不反轉，也不攔截。";
"Leave scrolling alone in this app" = "不改動這個應用程式裡的捲動";
"No other apps are open." = "沒有其他開啟的應用程式。";
"Choose a program…" = "選擇程式…";
"Programs" = "程式";

/* 登入時啟動：Windows 說「登入」。下面兩行在開關下方，Windows 不會照做時顯示。 */
"Launch at login" = "登入時啟動";
"Turned off in Task Manager" = "已在工作管理員中關閉";
"Couldn't set CalmMouse to start when you sign in." = "無法讓 CalmMouse 在登入時啟動。";

/* 設定視窗（審閱修改）：頁面清單的名稱、螢幕報讀程式對開關的稱呼、移除按鈕、已關閉的規則。%@ 是應用程式的名稱。另外依 Windows 用詞把「開」「關」改成「開啟」「關閉」。 */
"Pages" = "頁面";
"toggle switch" = "切換開關";
"Remove %@" = "移除 %@";
"The rule is off, so this doesn't apply for now." = "規則已關閉，暫不生效。";
"On" = "開啟";
"Off" = "關閉";
