/* CalmMouse for Windows: strings only the Windows app uses, English.
   Same format as the Mac's Resources/en.lproj/Localizable.strings (keys are the English text).
   Loaded on top of the Mac table, so an entry here wins over the Mac's.
   Every key here must be in all three tables (CalmMouse.Win.Tests checks). */

/* Notification-area icon: menu */
"Pause CalmMouse" = "Pause CalmMouse";
"Resume CalmMouse" = "Resume CalmMouse";
"Try again" = "Try again";

/* Notification-area icon: what's wrong, in the tooltip and at the top of the menu */
"CalmMouse stopped because of a problem. Your mouse scrolls as usual." = "CalmMouse stopped because of a problem. Your mouse scrolls as usual.";
"CalmMouse couldn't start. Your mouse scrolls as usual." = "CalmMouse couldn't start. Your mouse scrolls as usual.";
"Something on this PC is blocking CalmMouse, so your mouse scrolls as usual for now. It will try again soon." = "Something on this PC is blocking CalmMouse, so your mouse scrolls as usual for now. It will try again soon.";

/* Settings window */
"CalmMouse Settings" = "CalmMouse Settings";
"Language" = "Language";
"Same as Windows" = "Same as Windows";

/* Other mouse software. %@ is one name, or a list such as "SmoothScroll and AutoHotkey". */
"%@ can also change how your mouse scrolls. If scrolling feels odd, turn off one of them." = "%@ can also change how your mouse scrolls. If scrolling feels odd, turn off one of them.";
/* Joins the last two names of a list. */
"%@ and %@" = "%@ and %@";

/* Settings window: pages, the explanations in the side panel (\n breaks a line there), devices and app rules */
"App rules" = "App rules";
"Rules follow the window under the pointer,\nthe one the wheel scrolls,\neven when another app is in front." = "Rules follow the window under the pointer,\nthe one the wheel scrolls,\neven when another app is in front.";
"Every mouse scrolls as usual\nuntil you turn this off." = "Every mouse scrolls as usual\nuntil you turn this off.";
"CalmMouse starts by itself\nwhen you sign in to Windows." = "CalmMouse starts by itself\nwhen you sign in to Windows.";
"“Same as Windows” follows\nthe Windows display language." = "“Same as Windows” follows\nthe Windows display language.";
"No mouse found yet." = "No mouse found yet.";
"Touchpad" = "Touchpad";
"CalmMouse leaves the touchpad alone." = "CalmMouse leaves the touchpad alone.";
"Pick an app that's open now,\nor choose a program file." = "Pick an app that's open now,\nor choose a program file.";
"Add an app…" = "Add an app…";
"No app rules yet." = "No app rules yet.";
"Turn a rule off to keep it\nwithout using it for now." = "Turn a rule off to keep it\nwithout using it for now.";
"Every mouse scrolls a notch at a time here.\nFor older apps that miss small steps." = "Every mouse scrolls a notch at a time here.\nFor older apps that miss small steps.";
