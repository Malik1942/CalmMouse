/* CalmMouse for Windows：只有 Windows 版用到的文字，简体中文。
   格式和 Mac 版 Resources/zh-Hans.lproj/Localizable.strings 相同（键是英文原文），
   叠加在 Mac 版的表上，同一个键以这里为准。用词跟随 Windows：鼠标、设置、滚动。 */

/* 通知区域图标：菜单 */
"Pause CalmMouse" = "暂停 CalmMouse";
"Resume CalmMouse" = "恢复 CalmMouse";
"Try again" = "重试";

/* 通知区域图标：出了什么问题（提示文字和菜单顶部） */
"CalmMouse stopped because of a problem. Your mouse scrolls as usual." = "CalmMouse 出了问题，已经停止。鼠标照常滚动。";
"CalmMouse couldn't start. Your mouse scrolls as usual." = "CalmMouse 无法启动。鼠标照常滚动。";
"Something on this PC is blocking CalmMouse, so your mouse scrolls as usual for now. It will try again soon." = "这台电脑上有程序拦住了 CalmMouse，鼠标暂时照常滚动，稍后会再试。";

/* 设置窗口 */
"CalmMouse Settings" = "CalmMouse 设置";
"Language" = "语言";
"Same as Windows" = "跟随 Windows";

/* 其他鼠标软件。%@ 是一个名字，或者像“SmoothScroll 和 AutoHotkey”这样的列表。 */
"%@ can also change how your mouse scrolls. If scrolling feels odd, turn off one of them." = "%@ 也可能改变鼠标的滚动方式。如果滚动感觉不对劲，请关掉其中一个。";
/* 连接列表的最后两个名字。 */
"%@ and %@" = "%@ 和 %@";

/* 设置窗口：页面、右侧面板里的说明（\n 在那里换行）、设备和应用规则 */
"App rules" = "应用规则";
"Rules follow the window under the pointer,\nthe one the wheel scrolls,\neven when another app is in front." = "规则看的是指针下方的窗口，\n也就是滚轮正在滚动的那个，\n即使前台是别的应用。";
"Every mouse scrolls as usual\nuntil you turn this off." = "所有鼠标照常滚动，\n直到你关掉这一项。";
"CalmMouse starts by itself\nwhen you sign in to Windows." = "登录 Windows 时\nCalmMouse 自动启动。";
"“Same as Windows” follows\nthe Windows display language." = "“跟随 Windows”会使用\nWindows 的显示语言。";
"No mouse found yet." = "还没有找到鼠标。";
"Touchpad" = "触摸板";
"CalmMouse leaves the touchpad alone." = "CalmMouse 不会改动触摸板。";
"Pick an app that's open now,\nor choose a program file." = "从现在打开的应用里挑一个，\n或者选择一个程序文件。";
"Add an app…" = "添加应用…";
"No app rules yet." = "还没有应用规则。";
"Turn a rule off to keep it\nwithout using it for now." = "暂时用不上的规则可以关掉，\n不必删除。";
"Every mouse scrolls a notch at a time here.\nFor older apps that miss small steps." = "在这里，每只鼠标都一格一格地滚动。\n适合跟不上小步滚动的旧程序。";
"Don't smooth scrolling in this app" = "在这个应用里不平滑滚动";
"CalmMouse doesn't touch scrolling here:\nno smoothing, no reversing, nothing held back." = "CalmMouse 不碰这里的滚动：\n不平滑、不反转，也不拦下任何滚动。";
"Leave scrolling alone in this app" = "不改动这个应用里的滚动";
"No other apps are open." = "没有其他打开的应用。";
"Choose a program…" = "选择程序…";
"Programs" = "程序";
