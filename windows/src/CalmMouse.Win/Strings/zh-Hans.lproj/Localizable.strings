/* CalmMouse for Windows：只有 Windows 版用到的文字，简体中文。
   格式和 Mac 版 Resources/zh-Hans.lproj/Localizable.strings 相同（键是英文原文），
   叠加在 Mac 版的表上，同一个键以这里为准。用词跟随 Windows：鼠标、设置、滚动。 */

/* 通知区域图标：菜单 */
"Pause CalmMouse" = "暂停 CalmMouse";
"Resume CalmMouse" = "恢复 CalmMouse";
"Try again" = "重试";

/* 通知区域图标：出了什么问题（提示文字和菜单顶部） */
"CalmMouse stopped because of a problem. Your mouse scrolls as usual." = "CalmMouse 出现问题，已停止运行。鼠标会照常滚动。";
"CalmMouse couldn't start. Your mouse scrolls as usual." = "CalmMouse 无法启动。鼠标照常滚动。";
"Something on this PC is blocking CalmMouse, so your mouse scrolls as usual for now. It will try again soon." = "这台电脑上有程序阻止了 CalmMouse，鼠标暂时照常滚动，稍后会自动重试。";

/* 设置窗口 */
"CalmMouse Settings" = "CalmMouse 设置";
"Language" = "语言";
"Same as Windows" = "跟随 Windows";

/* 其他鼠标软件。%@ 是一个名字，或者像“SmoothScroll 和 AutoHotkey”这样的列表。 */
"%@ can also change how your mouse scrolls. If scrolling feels odd, turn off one of them." = "%@ 也可能改变鼠标的滚动方式。如果滚动感觉异常，请关闭其中一个。";
/* 连接列表的最后两个名字。 */
"%@ and %@" = "%@ 和 %@";

/* 设置窗口：页面、右侧面板里的说明（\n 在那里换行）、设备和应用规则 */
"App rules" = "应用规则";
"Rules follow the window under the pointer,\nthe one the wheel scrolls,\neven when another app is in front." = "规则按指针下方的窗口来判断，\n也就是滚轮正在滚动的窗口，\n即使它不在前台。";
"Every mouse scrolls as usual\nuntil you turn this off." = "所有鼠标照常滚动，\n直到你关掉这一项。";
"CalmMouse starts by itself\nwhen you sign in to Windows." = "登录 Windows 时\nCalmMouse 自动启动。";
"“Same as Windows” follows\nthe Windows display language." = "“跟随 Windows”会使用\nWindows 的显示语言。";
"No mouse found yet." = "还没有找到鼠标。";
"Touchpad" = "触摸板";
"CalmMouse leaves the touchpad alone." = "CalmMouse 不会改动触摸板。";
"Pick an app that's open now,\nor choose a program file." = "从当前打开的应用中选择一个，\n或选择程序文件。";
"Add an app…" = "添加应用…";
"No app rules yet." = "还没有应用规则。";
"Turn a rule off to keep it\nwithout using it for now." = "暂时用不上的规则可以关掉，\n不必删除。";
"Every mouse scrolls a notch at a time here.\nFor older apps that miss small steps." = "在这里，每只鼠标都一格一格地滚动。\n适合识别不了细微滚动的旧程序。";
"No smooth scrolling in this app" = "在这个应用里关闭平滑滚动";
"CalmMouse doesn't touch scrolling here:\nno smoothing, no reversing, nothing blocked." = "CalmMouse 不处理这里的滚动：\n不平滑、不反转，也不拦截。";
"Leave scrolling alone in this app" = "不改动这个应用里的滚动";
"No other apps are open." = "没有其他打开的应用。";
"Choose a program…" = "选择程序…";
"Programs" = "程序";

/* 登录时启动：Windows 说“登录”。下面两行在开关下方，Windows 不会照做时显示。 */
"Launch at login" = "登录时启动";
"Turned off in Task Manager" = "已在任务管理器中关闭";
"Couldn't set CalmMouse to start when you sign in." = "无法让 CalmMouse 在登录时启动。";

/* 设置窗口（审阅修改）：页面列表的名称、屏幕阅读器对开关的称呼、移除按钮、已关闭的规则。%@ 是应用的名称。 */
"Pages" = "页面";
"toggle switch" = "切换开关";
"Remove %@" = "移除 %@";
"The rule is off, so this doesn't apply for now." = "规则已关闭，暂不生效。";
"On" = "开";
"Off" = "关";
