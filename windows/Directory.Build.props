<Project>

  <!--
    Shared settings for everything under windows/ (the solution's four projects).
    windows/probe has its own Directory.Build.props, so it does not pick these up.
  -->
  <PropertyGroup>
    <!-- Lets the net10.0-windows projects restore and build on macOS and Linux too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A new NuGet advisory should warn, not break the build. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <LangVersion>latest</LangVersion>

    <Version>0.1.0</Version>
    <Authors>MalikZ</Authors>
    <Company>MalikZ</Company>
    <Product>CalmMouse</Product>
  </PropertyGroup>

</Project>
