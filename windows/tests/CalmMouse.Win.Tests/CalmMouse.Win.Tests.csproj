<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows-only tests for CalmMouse.Win: hook and SendInput integration. -->
  <PropertyGroup>
    <!-- Windows 10 1809 and later, so CsWin32 APIs marked Windows 10+ compile. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    xUnit v3 run through VSTest ("mtp-off" plus the VSTest adapter), so a plain
    `dotnet test` works from any folder without a repo-root global.json opting the
    .NET 10 SDK into Microsoft.Testing.Platform.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CalmMouse.Core\CalmMouse.Core.csproj" />
    <ProjectReference Include="..\..\src\CalmMouse.Win\CalmMouse.Win.csproj" />
  </ItemGroup>

</Project>
